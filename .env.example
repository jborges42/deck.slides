# Variáveis do deck.slides. Na Vercel, cadastre em Settings → Environment Variables (ambiente Production).
# Localmente, copie para .env (que não vai para o git) só se quiser rodar contra o Supabase.

# Banco: Supabase → Connect → Transaction pooler (porta 6543), com a senha do banco no lugar de [YOUR-PASSWORD].
# A integração Supabase ↔ Vercel cria POSTGRES_URL sozinha; o app aceita qualquer uma das duas.
DATABASE_URL=postgresql://postgres.<projeto>:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Conta de gestor criada no deploy (só se ainda não existir; a senha nunca é sobrescrita depois).
ADMIN_EMAIL=joao.matias@edu.sc.senai.br
ADMIN_NAME=João Vitor Borges
ADMIN_PASSWORD=

# Endereço público: base dos links de convite, do QR e do pareamento da tela.
PUBLIC_URL=https://deck-slides.vercel.app

# Opcionais
# SESSION_SECRET=   32 caracteres ou mais (openssl rand -base64 48). Sem ele, o app gera um e guarda no banco.
# SETUP_TOKEN=      só para criar a primeira conta pela tela /entrar, quando não se usa ADMIN_EMAIL.
# BLOB_READ_WRITE_TOKEN= criado ao conectar um Vercel Blob ao projeto (Storage); necessário para enviar mídia.
# MAX_UPLOAD_MB=1024
