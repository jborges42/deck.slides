{
  "name": "deck-slides",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.8.2",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/chivo-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource-variable/spline-sans-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "uqr": "0.1.3",
    "vite": "8.3.4"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:vercel": "node scripts/vercel-build.ts",
    "start": "NODE_ENV=production node server/index.ts",
    "check": "tsc -p . && tsc -p server",
    "test": "node --test --test-concurrency=4 'server/**/*.test.ts' 'shared/**/*.test.ts' 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "test:pg": "node --test --test-force-exit --test-concurrency=4 'server/**/*.test.ts'",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include='server/**/*.ts' --test-coverage-include='shared/**/*.ts' --test-coverage-include='src/lib/**/*.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='server/tests/**' 'server/**/*.test.ts' 'shared/**/*.test.ts' 'src/**/*.test.ts'",
    "test:e2e": "vite build && node --test --test-concurrency=1 'e2e/**/*.test.ts'",
    "seed": "node server/seed.ts",
    "lint": "node scripts/lint.ts",
    "verify": "pnpm check && pnpm lint && pnpm test",
    "audit": "pnpm audit --prod"
  }
}
